<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kairon.saros.mapper.TagMapper">

    <!-- tags 表 SQL 实现（Java 接口定义见 com.kairon.saros.mapper.TagMapper） -->

    <delete id="deleteTags">
        DELETE FROM tags WHERE manual_knowledge_id = #{knowledgeId}
    </delete>

    <insert id="insertTag">
        INSERT INTO tags (manual_knowledge_id, name) VALUES (#{knowledgeId}, #{name})
    </insert>

    <!-- 按 id 升序（对应阶段二 array_agg ORDER BY t.id） -->
    <select id="findTagsByKnowledgeIds" resultType="com.kairon.saros.po.Tag">
        SELECT manual_knowledge_id, name
        FROM tags
        WHERE manual_knowledge_id IN
        <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
        ORDER BY id
    </select>

    <!-- 标签自动补全：仅当前用户笔记的标签，ILIKE 匹配，去重升序，上限 20 -->
    <select id="suggestTags" resultType="string">
        SELECT DISTINCT t.name
        FROM tags t
        JOIN manual_knowledge mk ON mk.id = t.manual_knowledge_id
        WHERE mk.user_id = #{userId} AND t.name ILIKE #{pattern}
        ORDER BY t.name
        LIMIT 20
    </select>

</mapper>
